# Database (PostgreSQL). On Neon: pooled URL here, direct URL below.
DATABASE_URL="postgresql://postgres:password@localhost:5432/riziq_khamar"
DIRECT_URL="postgresql://postgres:password@localhost:5432/riziq_khamar"

# Signs the dashboard session. Use a long random string (32+ characters).
JWT_SECRET=""

# The site's address, without a trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3006"

# Product photos. Cloudinary dashboard > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# New order emails (optional). Without these, orders still work and no mail is sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# The dashboard account `npm run db:seed` creates.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
